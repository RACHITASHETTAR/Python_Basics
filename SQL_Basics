subquery-FROM clause
-Select country,continent,total_population as cnty_population from population 
-Select continent, SUM(total_population)AS cont_population FROM population GROUP BY continent
joinabove two queries:
Select cnt.country,cnt.continent,cnt.total_population as cnty_population,cont.cont_population
from population cnt 
JOIN (Select continent, SUM(total_population)AS cont_population 
FROM population GROUP BY continent)cont 
ON cnty.continent = cont.continent
